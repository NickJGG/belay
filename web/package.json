{
  "name": "belay-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/generate.ts --watch node node_modules/next/dist/bin/next dev -H 127.0.0.1 -p 4747",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 4747",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:bridge": "tsc -p ../bridge",
    "test:bridge": "tsc -p ../bridge && node --test \"../bridge/test/*.test.mts\" \"../extensions/*/test/bridge/*.test.mts\"",
    "test:plugin": "node --test \"../extensions/*/test/plugin/*.test.js\"",
    "test:site": "node --test \"src/lib/test/*.test.ts\" \"../extensions/*/test/site/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "chokidar": "6.0.0",
    "cmdk": "1.1.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "0.19.0",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "next": "16.2.7",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "0.0.1",
    "style-mod": "4.1.4",
    "typescript": "5.9.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.7"
  }
}
