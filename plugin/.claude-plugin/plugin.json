{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "belay",
  "version": "0.6.0",
  "description": "Belay: the channel bridge that lets the Belay site read, answer and steer your Claude Code sessions.",
  "author": {
    "name": "Nick",
    "email": "nick.gilliam2@gmail.com"
  },
  "mcpServers": {
    "belay": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/bridge/server.mjs"]
    }
  },
  "channels": [
    {
      "server": "belay"
    }
  ]
}
