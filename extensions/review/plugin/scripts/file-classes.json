{
  "secret": [
    "**/.env",
    "**/.env.*",
    "**/id_rsa",
    "**/id_dsa",
    "**/id_ecdsa",
    "**/id_ed25519",
    "**/.npmrc",
    "**/.pypirc",
    "**/.netrc",
    "**/credentials",
    "**/credentials.{json,yml,yaml,xml,ini,toml}",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/*.jks",
    "**/*.keystore"
  ],
  "notSecret": [
    "**/.env.example",
    "**/.env.sample",
    "**/.env.template",
    "**/.env.dist"
  ],
  "exclude": {
    "lockfile": [
      "**/package-lock.json",
      "**/npm-shrinkwrap.json",
      "**/yarn.lock",
      "**/pnpm-lock.yaml",
      "**/bun.lock",
      "**/bun.lockb",
      "**/Cargo.lock",
      "**/poetry.lock",
      "**/Pipfile.lock",
      "**/uv.lock",
      "**/go.sum",
      "**/composer.lock",
      "**/Gemfile.lock",
      "**/packages.lock.json"
    ],
    "vendored": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/third_party/**"
    ],
    "generated": [
      "**/*.min.*",
      "**/*.map",
      "**/dist/**",
      "build/**",
      "**/*.pb.go",
      "**/*_pb2.py",
      "**/*.generated.*",
      "**/__snapshots__/**",
      "**/*.snap"
    ]
  },
  "binaryExtensions": [
    "png", "jpg", "jpeg", "gif", "bmp", "ico", "webp", "avif", "tif", "tiff", "psd",
    "pdf", "zip", "gz", "tgz", "bz2", "xz", "7z", "rar", "tar", "jar", "war",
    "exe", "dll", "so", "dylib", "bin", "o", "a", "lib", "class", "pyc", "wasm",
    "woff", "woff2", "ttf", "otf", "eot",
    "mp3", "mp4", "wav", "ogg", "flac", "webm", "mov", "avi",
    "db", "sqlite", "sqlite3"
  ],
  "classes": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs,mts,cts}": ["code"],
    "**/*.{tsx,jsx}": ["ui"],
    "**/*.{java,kt,kts,scala}": ["code"],
    "**/*.py": ["code"],
    "**/*.go": ["code"],
    "**/*.rs": ["code"],
    "**/*.{cs,fs,vb}": ["code"],
    "**/*.{c,h,cc,cpp,hpp,cxx}": ["code"],
    "**/*.{rb,php,swift,lua,dart}": ["code"],
    "**/*.sql": ["code"],
    "**/*.{sh,bash,ps1}": ["code"],
    "**/*.{md,mdx}": ["docs"],
    "**/*.json": ["data"],
    "**/*.{html,vue,svelte,astro}": ["code", "ui"],
    "**/*.{css,scss,sass,less}": ["ui"],
    "**/*.{yaml,yml,toml}": ["data"],
    "**/*.{test,spec}.{ts,tsx,js,jsx,mjs,cjs,mts,cts}": ["test"],
    "**/*Test.{java,kt}": ["test"],
    "**/*Tests.{java,kt,cs}": ["test"],
    "**/*_test.go": ["test"],
    "**/*_test.py": ["test"],
    "**/test_*.py": ["test"],
    "**/*_test.rs": ["test"],
    "**/*_spec.rb": ["test"],
    "**/__tests__/**": ["test"],
    "**/tests/**": ["test"],
    "**/test/**": ["test"],
    "**/messages*.{json,xlf,properties}": ["i18n"],
    "**/i18n/**": ["i18n"],
    "**/locales/**": ["i18n"],
    "**/{en,fr,de,es,zh}.json": ["i18n"],
    "**/migrations/**": ["contract"],
    "**/*.proto": ["contract"],
    "**/*.graphql": ["contract"],
    "**/*.gql": ["contract"],
    "**/openapi*.{yaml,yml,json}": ["contract"],
    "**/schema*.{sql,json}": ["contract"],
    "**/api/**": ["contract"],
    "**/routes/**": ["contract"],
    "**/controllers/**": ["contract"],
    "**/handlers/**": ["contract"],
    "**/endpoints/**": ["contract"],
    "**/*auth*/**": ["security"],
    "**/*login*/**": ["security"],
    "**/*session*/**": ["security"],
    "**/*token*/**": ["security"],
    "**/*crypto*/**": ["security"],
    "**/*jwt*/**": ["security"],
    "**/*permission*/**": ["security"],
    "**/*guard*/**": ["security"],
    "**/*middleware*/**": ["security"],
    "**/*auth*": ["security"],
    "**/*login*": ["security"],
    "**/*session*": ["security"],
    "**/*token*": ["security"],
    "**/*crypto*": ["security"],
    "**/*jwt*": ["security"],
    "**/*permission*": ["security"],
    "**/*guard*": ["security"],
    "**/*middleware*": ["security"],
    "**/proxy.{ts,js}": ["security"],
    "**/Dockerfile*": ["security"],
    "**/docker-compose*.{yml,yaml}": ["security"],
    ".github/workflows/**": ["security"]
  },
  "content_signals": {
    "security": [
      "\\.(?:innerHTML|outerHTML)\\s*=",
      "insertAdjacentHTML\\(",
      "dangerouslySetInnerHTML",
      "document\\.write\\(",
      "\\beval\\(",
      "new Function\\(",
      "\\bexecSync\\(",
      "\\bexecFileSync\\(",
      "\\bexecFile\\(",
      "\\bspawnSync\\(",
      "from [\"'](?:node:)?child_process[\"']",
      "require\\([\"'](?:node:)?child_process[\"']\\)",
      "\\breadFileSync\\(\\s*join\\(",
      "\\bwriteFileSync\\(\\s*join\\(",
      "(?<!\\.)\\bfetch\\(\\s*\\w+\\s*[,)]",
      "(?<!\\.)\\brequest\\(\\s*\\w+\\s*,",
      "axios\\.get\\(\\s*\\w+\\s*\\)",
      "http\\.get\\(\\s*\\w+\\s*,",
      "rejectUnauthorized:\\s*false",
      "NODE_TLS_REJECT_UNAUTHORIZED",
      "checkServerIdentity\\s*:\\s*\\(\\s*\\)\\s*=>",
      "/\\[\",\\\\n\\\\r\\]/",
      "escapeField\\("
    ]
  }
}
