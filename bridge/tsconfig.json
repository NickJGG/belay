{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "rootDir": ".",
    "outDir": "../plugin/bridge",
    "types": ["node"]
  },
  "include": ["*.mts", "kinds/*.mts"]
}
